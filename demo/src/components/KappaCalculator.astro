---
// Live Cohen's Kappa calculator — editable confusion matrix, presets, and a
// Landis–Koch band readout. All computation is client-side (see ../lib/kappa).
---
<div class="kappa" data-kappa>
  <div class="kappa-controls">
    <div class="preset-row" role="group" aria-label="Presets">
      <button class="btn" data-preset="good">Good judge</button>
      <button class="btn" data-preset="paradox">Kappa paradox</button>
      <button class="btn" data-preset="random">Random judge</button>
      <button class="btn" data-preset="perfect">Perfect</button>
    </div>
    <div class="size-row">
      <span class="note">Categories:</span>
      <button class="btn size" data-size="2" aria-pressed="true">2 × 2</button>
      <button class="btn size" data-size="3" aria-pressed="false">3 × 3</button>
    </div>
  </div>

  <div class="kappa-body">
    <div class="matrix-wrap">
      <div class="matrix-corner note">counts →</div>
      <table class="matrix" data-matrix></table>
      <p class="note matrix-hint">Rows = human label · Columns = judge label · diagonal = they agreed. Edit any cell.</p>
    </div>

    <div class="readout" data-readout>
      <div class="stat-row">
        <div class="stat-item"><span class="note">p<sub>o</sub> · observed</span><strong data-po>—</strong></div>
        <div class="stat-item"><span class="note">p<sub>e</sub> · chance</span><strong data-pe>—</strong></div>
        <div class="stat-item"><span class="note">N · items</span><strong data-n>—</strong></div>
      </div>
      <div class="kappa-big">
        <span class="note">Cohen's κ</span>
        <div class="kappa-value" data-kappa-value>—</div>
        <div class="kappa-band" data-band>—</div>
      </div>
      <div class="bands" data-bands></div>
    </div>
  </div>
</div>

<style>
  .kappa { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; background: var(--paper-2); }
  .kappa-controls { display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; padding: 16px 18px; border-bottom: 1px solid var(--line); background: var(--paper); }
  .preset-row, .size-row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .kappa-body { display: grid; grid-template-columns: 1.05fr 1fr; gap: 0; }
  .matrix-wrap { padding: 24px; border-right: 1px solid var(--line); }
  .matrix-corner { margin-bottom: 8px; }
  table.matrix { border-collapse: collapse; }
  table.matrix th { font-family: var(--mono); font-size: 11px; font-weight: 600; color: var(--muted); padding: 6px 8px; text-transform: uppercase; letter-spacing: 0.03em; }
  table.matrix th.col { color: var(--ink); }
  table.matrix th.row { text-align: right; color: var(--ink); }
  table.matrix td { border: 1px solid var(--line); padding: 0; }
  table.matrix td.diag { background: #fbe9e7; }
  table.matrix input { width: 64px; height: 48px; border: none; background: transparent; text-align: center; font-family: var(--mono); font-size: 17px; color: var(--ink); -moz-appearance: textfield; }
  table.matrix input:focus { outline: 2px solid var(--accent); outline-offset: -2px; }
  .matrix-hint { margin-top: 12px; max-width: 34ch; }

  .readout { padding: 24px; }
  .stat-row { display: flex; gap: 22px; margin-bottom: 18px; }
  .stat-item { display: flex; flex-direction: column; }
  .stat-item strong { font-family: var(--mono); font-size: 24px; font-weight: 600; }
  .kappa-big { border-top: 1px solid var(--line); padding-top: 16px; }
  .kappa-value { font-size: 64px; font-weight: 800; letter-spacing: -0.04em; line-height: 1; }
  .kappa-band { font-size: 15px; font-weight: 700; margin-top: 4px; }
  .bands { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 18px; }
  .bands .b { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; padding: 4px 8px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); }
  .bands .b.on { color: #fff; border-color: transparent; }
  @media (max-width: 820px) { .kappa-body { grid-template-columns: 1fr; } .matrix-wrap { border-right: none; border-bottom: 1px solid var(--line); } }
</style>

<script>
  import { cohenKappa, observedAgreement, expectedAgreement, total, landisKoch, allBands } from '../lib/kappa';

  type Mat = number[][];
  const LABELS: Record<number, string[]> = {
    2: ['Pass', 'Fail'],
    3: ['Good', 'Okay', 'Bad'],
  };
  const PRESETS: Record<string, Mat> = {
    good: [[45, 10], [5, 40]],
    paradox: [[85, 5], [5, 5]],
    random: [[25, 25], [25, 25]],
    perfect: [[50, 0], [0, 50]],
  };

  const fmt = (x: number) => (Math.round(x * 1000) / 1000).toFixed(3);

  document.querySelectorAll<HTMLElement>('[data-kappa]').forEach((root) => {
    let matrix: Mat = PRESETS.good.map((r) => [...r]);

    const matrixEl = root.querySelector<HTMLTableElement>('[data-matrix]')!;
    const bandsEl = root.querySelector<HTMLElement>('[data-bands]')!;

    function renderMatrix() {
      const n = matrix.length;
      const labels = LABELS[n];
      let html = '<tr><th></th>';
      for (let j = 0; j < n; j++) html += `<th class="col">Judge: ${labels[j]}</th>`;
      html += '</tr>';
      for (let i = 0; i < n; i++) {
        html += `<tr><th class="row">Human: ${labels[i]}</th>`;
        for (let j = 0; j < n; j++) {
          const cls = i === j ? ' class="diag"' : '';
          html += `<td${cls}><input type="number" min="0" step="1" value="${matrix[i][j]}" data-i="${i}" data-j="${j}" aria-label="Human ${labels[i]}, Judge ${labels[j]}"></td>`;
        }
        html += '</tr>';
      }
      matrixEl.innerHTML = html;
      matrixEl.querySelectorAll<HTMLInputElement>('input').forEach((inp) => {
        inp.addEventListener('input', () => {
          const i = +inp.dataset.i!, j = +inp.dataset.j!;
          matrix[i][j] = Math.max(0, Math.floor(+inp.value || 0));
          compute();
        });
      });
    }

    function renderBands(active: string) {
      bandsEl.innerHTML = allBands()
        .map((b) => {
          const on = b.label === active;
          return `<span class="b${on ? ' on' : ''}" style="${on ? `background:${b.color}` : ''}">${b.label}</span>`;
        })
        .join('');
    }

    function compute() {
      const po = observedAgreement(matrix);
      const pe = expectedAgreement(matrix);
      const k = cohenKappa(matrix);
      const band = landisKoch(k);
      root.querySelector('[data-po]')!.textContent = fmt(po);
      root.querySelector('[data-pe]')!.textContent = fmt(pe);
      root.querySelector('[data-n]')!.textContent = String(total(matrix));
      const kv = root.querySelector<HTMLElement>('[data-kappa-value]')!;
      kv.textContent = (Math.round(k * 100) / 100).toFixed(2);
      kv.style.color = band.color;
      const bandEl = root.querySelector<HTMLElement>('[data-band]')!;
      bandEl.textContent = band.label.toUpperCase();
      bandEl.style.color = band.color;
      renderBands(band.label);
    }

    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((btn) => {
      btn.addEventListener('click', () => {
        matrix = PRESETS[btn.dataset.preset!].map((r) => [...r]);
        setSize(2);
        renderMatrix();
        compute();
      });
    });

    function setSize(n: number) {
      root.querySelectorAll<HTMLButtonElement>('[data-size]').forEach((b) =>
        b.setAttribute('aria-pressed', String(+b.dataset.size! === n)),
      );
    }

    root.querySelectorAll<HTMLButtonElement>('[data-size]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const n = +btn.dataset.size!;
        if (n === matrix.length) return;
        matrix = Array.from({ length: n }, (_, i) =>
          Array.from({ length: n }, (_, j) => (i === j ? 20 : 4)),
        );
        setSize(n);
        renderMatrix();
        compute();
      });
    });

    renderMatrix();
    compute();
  });
</script>
