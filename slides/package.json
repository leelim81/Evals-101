{
  "name": "slides",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "slidev --open",
    "build": "slidev build --base /Evals-101/slides/ --out dist",
    "export:pdf": "slidev export --output ../exports/evals-101.pdf",
    "export:pptx": "slidev export --format pptx --output ../exports/evals-101.pptx"
  },
  "dependencies": {
    "@slidev/cli": "52.15.2",
    "@slidev/theme-default": "^0.25.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "playwright-chromium": "^1.49.0"
  }
}
